{
    "annotations": {
        "list": []
    },
    "editable": true,
    "graphTooltip": 1,
    "panels": [
        {
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "title": "MySQL 서버 상태",
            "type": "row"
        },
        {
            "title": "MySQL 상태",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 4,
                "x": 0,
                "y": 1
            },
            "targets": [
                {
                    "expr": "mysql_up",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "mappings": [
                        {
                            "options": {
                                "0": {
                                    "color": "red",
                                    "text": "DOWN"
                                },
                                "1": {
                                    "color": "green",
                                    "text": "UP"
                                }
                            },
                            "type": "value"
                        }
                    ]
                }
            }
        },
        {
            "title": "Uptime",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 4,
                "x": 4,
                "y": 1
            },
            "targets": [
                {
                    "expr": "mysql_global_status_uptime",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s"
                }
            }
        },
        {
            "title": "현재 연결 수",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 4,
                "x": 8,
                "y": 1
            },
            "targets": [
                {
                    "expr": "mysql_global_status_threads_connected",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 50
                            },
                            {
                                "color": "red",
                                "value": 100
                            }
                        ]
                    }
                }
            }
        },
        {
            "title": "연결 사용률 (%)",
            "type": "gauge",
            "gridPos": {
                "h": 4,
                "w": 4,
                "x": 12,
                "y": 1
            },
            "targets": [
                {
                    "expr": "mysql_global_status_threads_connected / mysql_global_variables_max_connections * 100",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 60
                            },
                            {
                                "color": "red",
                                "value": 80
                            }
                        ]
                    }
                }
            }
        },
        {
            "title": "실행 중인 쿼리",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 4,
                "x": 16,
                "y": 1
            },
            "targets": [
                {
                    "expr": "mysql_global_status_threads_running",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 10
                            },
                            {
                                "color": "red",
                                "value": 30
                            }
                        ]
                    }
                }
            }
        },
        {
            "title": "슬로우 쿼리 (누적)",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 4,
                "x": 20,
                "y": 1
            },
            "targets": [
                {
                    "expr": "mysql_global_status_slow_queries",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "fixedColor": "orange",
                        "mode": "fixed"
                    }
                }
            }
        },
        {
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 5
            },
            "title": "쿼리 성능 분석",
            "type": "row"
        },
        {
            "title": "슬로우 쿼리 증가율 (5분)",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 6
            },
            "targets": [
                {
                    "expr": "rate(mysql_global_status_slow_queries[5m])",
                    "legendFormat": "Slow Queries/sec",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "fixedColor": "orange",
                        "mode": "fixed"
                    },
                    "custom": {
                        "fillOpacity": 20,
                        "lineWidth": 2
                    }
                }
            }
        },
        {
            "title": "Full Table Scan 비율",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 6
            },
            "targets": [
                {
                    "expr": "rate(mysql_global_status_handler_read_rnd_next[1m])",
                    "legendFormat": "Full Scans/sec",
                    "refId": "A"
                },
                {
                    "expr": "rate(mysql_global_status_select_scan[1m])",
                    "legendFormat": "Select Scans/sec",
                    "refId": "B"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "fillOpacity": 15,
                        "lineWidth": 2
                    }
                }
            }
        },
        {
            "title": "초당 쿼리 수 (QPS)",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 14
            },
            "targets": [
                {
                    "expr": "rate(mysql_global_status_questions[1m])",
                    "legendFormat": "Questions/sec",
                    "refId": "A"
                },
                {
                    "expr": "rate(mysql_global_status_queries[1m])",
                    "legendFormat": "Queries/sec",
                    "refId": "B"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "fillOpacity": 10,
                        "lineWidth": 2
                    }
                }
            }
        },
        {
            "title": "연결 수 추이",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 14
            },
            "targets": [
                {
                    "expr": "mysql_global_status_threads_connected",
                    "legendFormat": "Connected",
                    "refId": "A"
                },
                {
                    "expr": "mysql_global_status_threads_running",
                    "legendFormat": "Running",
                    "refId": "B"
                },
                {
                    "expr": "mysql_global_variables_max_connections",
                    "legendFormat": "Max Connections",
                    "refId": "C"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "fillOpacity": 10,
                        "lineWidth": 2
                    }
                }
            }
        },
        {
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 22
            },
            "title": "InnoDB 성능",
            "type": "row"
        },
        {
            "title": "InnoDB Buffer Pool 사용률",
            "type": "gauge",
            "gridPos": {
                "h": 6,
                "w": 6,
                "x": 0,
                "y": 23
            },
            "targets": [
                {
                    "expr": "(mysql_global_status_innodb_buffer_pool_pages_total - mysql_global_status_innodb_buffer_pool_pages_free) / mysql_global_status_innodb_buffer_pool_pages_total * 100",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 80
                            },
                            {
                                "color": "red",
                                "value": 95
                            }
                        ]
                    }
                }
            }
        },
        {
            "title": "InnoDB Row Operations",
            "type": "timeseries",
            "gridPos": {
                "h": 6,
                "w": 9,
                "x": 6,
                "y": 23
            },
            "targets": [
                {
                    "expr": "rate(mysql_global_status_innodb_rows_read[1m])",
                    "legendFormat": "Reads/sec",
                    "refId": "A"
                },
                {
                    "expr": "rate(mysql_global_status_innodb_rows_inserted[1m])",
                    "legendFormat": "Inserts/sec",
                    "refId": "B"
                },
                {
                    "expr": "rate(mysql_global_status_innodb_rows_updated[1m])",
                    "legendFormat": "Updates/sec",
                    "refId": "C"
                },
                {
                    "expr": "rate(mysql_global_status_innodb_rows_deleted[1m])",
                    "legendFormat": "Deletes/sec",
                    "refId": "D"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "fillOpacity": 10,
                        "lineWidth": 1
                    }
                }
            }
        },
        {
            "title": "InnoDB Buffer Pool Hit Rate",
            "type": "stat",
            "gridPos": {
                "h": 6,
                "w": 4,
                "x": 15,
                "y": 23
            },
            "targets": [
                {
                    "expr": "(1 - (rate(mysql_global_status_innodb_buffer_pool_reads[5m]) / rate(mysql_global_status_innodb_buffer_pool_read_requests[5m]))) * 100",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "decimals": 2,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "red",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 90
                            },
                            {
                                "color": "green",
                                "value": 99
                            }
                        ]
                    }
                }
            }
        },
        {
            "title": "InnoDB Disk I/O",
            "type": "timeseries",
            "gridPos": {
                "h": 6,
                "w": 5,
                "x": 19,
                "y": 23
            },
            "targets": [
                {
                    "expr": "rate(mysql_global_status_innodb_data_reads[1m])",
                    "legendFormat": "Data Reads/sec",
                    "refId": "A"
                },
                {
                    "expr": "rate(mysql_global_status_innodb_data_writes[1m])",
                    "legendFormat": "Data Writes/sec",
                    "refId": "B"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "fillOpacity": 10,
                        "lineWidth": 1
                    }
                }
            }
        }
    ],
    "refresh": "10s",
    "schemaVersion": 38,
    "style": "dark",
    "time": {
        "from": "now-1h",
        "to": "now"
    },
    "title": "MySQL 모니터링",
    "uid": "mysql-monitoring"
}